        this.ColumnAdd('免疫', '免疫', 2, true, 3);
        this.ColumnAdd('イムノクロマト', 'イムノクロマト', 1, true, 4);
        this.ColumnAdd('電解質', '電解質', 2, true, 4);
        this.ColumnAdd('CRP', 'CRP', 2, true, 4);
        this.ColumnAdd('血ガス', '血ガス', 1, true, 4);
        this.ColumnAdd('その他', 'その他', 1, true, 4);
    }
    DataTable.prototype.ColumnAdd = function (headertitle, path, columntype, IsShow, SearchConditionCol) {
        var IsShow2 = true;
        IsShow2 = IsShow;
        if (this.SC) {
            for (var index in this.SC.HideColumnList) {
                if (this.SC.HideColumnList[index] == path) {
                    IsShow2 = false;
                }
            }
        }
        var header = new DataTableColumnHeaderParent(headertitle, columntype, SearchConditionCol, IsShow2, path);
        var datacolumn = new DataTableDataColumn();
        datacolumn.Title = headertitle;
        switch (columntype) {
            case 0:
                datacolumn.Title = headertitle;
                datacolumn.Path = path;
                datacolumn.IsShow = IsShow2;
                this.DataHeaderColumns.push(datacolumn);
                break;
            default:
                for (var index in header.Children) {
                    var c = header.Children[index];
                    c.ColumnHeader = header;
                    this.ChildrenColumns.push(c);
                    var datacolumn = new DataTableDataColumn();
                    datacolumn.IsShow = IsShow2;
                    datacolumn.Title = headertitle;
                    datacolumn.Path = c.Path;
                    this.DataColumns.push(datacolumn);
                }
                break;
        }
        this.ParentColumns.push(header);
    };
    return DataTable;
})();
var DataTableColumnHeaderChild = (function () {
    function DataTableColumnHeaderChild() {
        this.IsShow = true;
    }
    return DataTableColumnHeaderChild;
})();
var DataTableColumnHeaderParent = (function () {
    function DataTableColumnHeaderParent(title, type, SearchConditionCol, IsShow, Path) {
        this.IsShow = IsShow;
        this.Path = Path;
        this.SearchConditionCol = SearchConditionCol;
        this.HeaderTitle = title;
        this.ColumnType = type;
        this.Children = new Array();
        if (type == 0) {
            this.RowSpan = 2;
            this.ColSpan = 1;
        }
        else if (type == 1) {
            var header1 = { HeaderTitle: '装置名', IsShow: true, ColumnHeader: this, Path: this.Path + '_ProductName__c' };
            var header2 = { HeaderTitle: '売上日', IsShow: true, ColumnHeader: this, Path: this.Path + '_ProductionStartDate__c' };
            this.Children.push(header1);
            this.Children.push(header2);
            this.RowSpan = 1;
            this.ColSpan = this.Children.length;
        }
        else if (type == 2) {
            var header1 = { HeaderTitle: '装置名', IsShow: true, ColumnHeader: this, Path: this.Path + '_ProductName__c' };
            var header2 = { HeaderTitle: '売上日', IsShow: true, ColumnHeader: this, Path: this.Path + '_ProductionStartDate__c' };
            var header3 = { HeaderTitle: '検体数', IsShow: true, ColumnHeader: this, Path: this.Path + '_TestCount' };
            this.Children.push(header1);
            this.Children.push(header2);
            this.Children.push(header3);
            this.RowSpan = 1;
            this.ColSpan = this.Children.length;
        }
        else if (type == 3) {
            var header1 = { HeaderTitle: '装置名', IsShow: true, ColumnHeader: this, Path: this.Path + '_ProductName__c' };
            var header2 = { HeaderTitle: 'フェーズ', IsShow: true, ColumnHeader: this, Path: this.Path + '_StageName__c' };
            var header3 = { HeaderTitle: '売上予定日', IsShow: true, ColumnHeader: this, Path: this.Path + '_ProductionStartDate__c' };
            this.Children.push(header1);
            this.Children.push(header2);
            this.Children.push(header3);
            this.RowSpan = 1;
            this.ColSpan = this.Children.length;
        }
    }
    return DataTableColumnHeaderParent;
})();
var DataTableDataColumn = (function () {
    function DataTableDataColumn() {
        this.Title = '';
        this.IsShow = true;
    }
    return DataTableDataColumn;
})();
var DataTableDataHeaderColumn = (function () {
    function DataTableDataHeaderColumn() {
        this.Title = '';
