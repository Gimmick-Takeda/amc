        $scope.SSOArray = ['01.札幌SSO', '02.仙台SSO', '03.さいたまSSO', '04.東京SSO', '05.名古屋SSO', '06.大阪SSO', '07.広島SSO', '08.福岡SSO', 'すべて'];
        $scope.AccountTable = new DataTable(new SearchCondition());
