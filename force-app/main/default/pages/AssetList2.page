        $scope.SearchConditionJSON = '';
        $scope.TableWidth = 2000;
        $scope.IsShowLoginButton = false;
        $scope.IsShowGetDataButton = false;
        function GetCondition(urlparam) {
            console.log('-GetCondition');
            $scope.message2 = 'GetCondition';
            var params = urlparam.split('&');
            var param1 = params[0].substr(4, 18);
            console.log(param1);
            console.log($scope.conn);
            $scope.conn.sobject("Idea").retrieve([param1], function (err, ret) {
                if (err) {
                    console.error(err);
                    return;
                }
                var GetSearchConditionSearchCondition = ret[0].SearchCondition__c;
                $scope.SearchConditionJSON = GetSearchConditionSearchCondition;
                $scope.SearchCondition = JSON.parse(GetSearchConditionSearchCondition);
                $scope.$apply();
                $scope.ShowResult();
            });
            var SearchConditionDisplay = (urlparam.indexOf("SearchConditionDisplay=none") > 0);
            if (SearchConditionDisplay) {
                $scope.SearchConditionDisplay = 'display:none';
            }
            $scope.message2 = '';
        }
        $scope.SetConnection = function (conn) {
            $scope.conn = conn;
            console.log('-SetConnection');
            if (location.hostname == 'localhost') {
                $scope.IsShowLoginButton = true;
                $scope.IsShowGetDataButton = true;
            }
        };
        $scope.GetSearchCondition = function () {
            console.log('-GetSearchCondition');
            $scope.message2 = 'GetSearchCondition';
            var urlparam = location.search;
            if (urlparam.length > 0) {
                if (location.hostname == 'localhost') {
                }
