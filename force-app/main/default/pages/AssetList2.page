                }
                var ideaid = ret.id;
                console.log(ideaid);
                document.location.href = "?id=" + ideaid;
                return;
            });
            return;
        };
        $scope.ShowResult = function () {
            $scope.message = 'データを取得しています。データ件数が多い場合、数分かかる場合があります。しばらくお待ちください・・・';
            console.log('-ShowResult');
            var sc = $scope.SearchCondition;
            console.log(sc);
            $scope.AccountTable = new DataTable(sc);
            var SQL = 'SELECT Id,AccountAddInfo__c, Name,SSO2__c,ShippingPostalCode,ShippingState,ShippingCity,ShippingStreet,Phone,CoreSystemCD__c,TDFKNumber__c,CCUSER__r.Name, YBeds__c,Classification__c,HbA1c__c,GLU__c,UrineQualitative__c,UrinarySediment__c,CBC__c,Biochemistry__c,Electrolyte__c,CRP__c,Item157__c,Item158__c,Item159__c,Item160__c,AccreditedTrainingFacility__c,DSurvey__c,TSurvey__c,CCReagentSaleRank__c,Website,DialySystemCD__c,';
            SQL = SQL + '  (SELECT Account__c, Id, Name,CategoryName1__c,CategoryName2__c,ProductName__c,ELAPSEDYEARS__c,ProductionStartDate__c FROM Account_Assets__r WHERE IsOperationEnd__c = false),';
            SQL = SQL + '  (SELECT Id, Name, StageName__c, ProductName__c, ProductPhase__c, CloseDate__c FROM OpportunityLineItems__r)  ';
            SQL = SQL + 'FROM Account WHERE (name <> \'\') ';
            if ($scope.SearchCondition.SSO !== 'すべて') {
                SQL = SQL + 'AND SSO2__c = \'' + $scope.SearchCondition.SSO + '\' ';
            }
            if ($scope.SearchCondition.state !== 'すべて') {
                SQL = SQL + 'AND ShippingState = \'' + $scope.SearchCondition.state + '\' ';
            }
            if ($scope.SearchCondition.classification === 'すべて') {
            }
            else if ($scope.SearchCondition.classification === 'すべて（卸・薬局以外）') {
                SQL = SQL + 'AND ((Classification__c = \'卸\') or (Classification__c = \'薬局\')) ';
            }
            else {
                SQL = SQL + 'AND Classification__c = \'' + $scope.SearchCondition.classification + '\' ';
            }
            if ($scope.SearchCondition.NameFilter !== '') {
                if ($scope.SearchCondition.NameFilter !== undefined) {
                    SQL = SQL + 'AND Name LIKE \'%' + $scope.SearchCondition.NameFilter + '%\' ';
                }
            }
            if ($scope.SearchCondition.CCUSERFilter !== '') {
                if ($scope.SearchCondition.CCUSERFilter !== undefined) {
                    SQL = SQL + 'AND CCUSER__r.Name LIKE \'%' + $scope.SearchCondition.CCUSERFilter + '%\' ';
                }
