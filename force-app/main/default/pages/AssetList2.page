            $scope.message2 = 'Search';
            var parentcols;
            parentcols = $scope.AccountTable.ParentColumns;
            $scope.SearchCondition.HideColumnList = new Array();
            parentcols.forEach(function (p) {
                if (p.IsShow == false) {
                    $scope.SearchCondition.HideColumnList.push(p.Path);
                }
            });
            $scope.SearchConditionJson = JSON.stringify($scope.SearchCondition);
            $scope.conn.sobject('Idea').create({ CommunityId: '09a5F000000L9KfQAK', Title: 'SC', Body: 'SC', Status: '', Categories: '', SearchCondition__c: $scope.SearchConditionJson }, function (err, ret) {
